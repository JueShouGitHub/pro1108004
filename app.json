{
  "expo": {
    "name": "SpotDiff",
    "slug": "pro1108004",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qzqsgdn.oqmpnw",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This application integrates push services and only accesses your location information when necessary to provide localized content (such as regional event notifications). You can turn this permission off at any time in the system settings."
      },
      "buildNumber": "7"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/icon.png",
      "permissions": [
        "android.permission.INTERNET",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.hlewuzyl.rahlqsbj",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withGradleMemory",
      "expo-tracking-transparency",
      "expo-build-properties",
      "expo-localization",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          },
          "ios": {
            "targetedDeviceFamily": "1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Used to provide personalized advertising and advertising effectiveness analysis"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "121192e6-dc79-4d5f-b8e3-8571fa5c3fb3"
      }
    },
    "owner": "jueshou"
  }
}
